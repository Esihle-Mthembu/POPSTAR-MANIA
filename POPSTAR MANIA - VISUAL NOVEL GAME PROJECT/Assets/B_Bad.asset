    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Cheomni
    dialogueText: "We didn\u2019t do well today.\r\n "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: -6762806206646994688, guid: 2fe95af7f855e5446856b00d0503fd1d, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "What does that have to do with anything?\r\n "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: -6762806206646994688, guid: 2fe95af7f855e5446856b00d0503fd1d, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonseo
    dialogueText: "It means the manager doesn\u2019t get us dinner.\r\n "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: -6762806206646994688, guid: 2fe95af7f855e5446856b00d0503fd1d, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "What? That\u2019s insane. Xuan Mo looks like she\u2019s about
      to pass out\u2026 everyone worked so hard\u2026 and they punish us with food?\r\n "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: -6762806206646994688, guid: 2fe95af7f855e5446856b00d0503fd1d, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "How is that allowed?\r\n "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: -6762806206646994688, guid: 2fe95af7f855e5446856b00d0503fd1d, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Xuan Mo
    dialogueText: "It\u2019s allowed. It\u2019s in the contract."
