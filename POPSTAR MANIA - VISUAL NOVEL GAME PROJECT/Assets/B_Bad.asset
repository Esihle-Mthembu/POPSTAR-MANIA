    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Rose moved up two tiers\u2026 just a few hours ago we were right
      next to each other.\r\n "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1420308086105476666, guid: 6e6079d8aca968a4e80e19bd62077d9b, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Rose
    dialogueText: "Don\u2019t worry about the scores today. You did your best.\r\n "
