    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: 'Thank you. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
