%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8e05ad892727404cbf0e9f236e5d962, type: 3}
  m_Name: B_Good
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    dialogueText: "My heart is pounding\u2026 that was so difficult. I really need
      to work on my vocals. Rose sounded amazing, even though she messed up. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 8300000, guid: 4b4d12a56e1af1f4e96414333857598c, type: 3}
    bgm: {fileID: 8300000, guid: 4738bdf42274e5c428f3975904410d66, type: 3}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'All the girls sit together on the couch while the manager and
      trainer talk on the other side of the room. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I wonder what they\u2019re saying about me\u2026 the trainer keeps
      looking my way. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'To my surprise, Cheomni is sitting alone on the other side of
      the room. She looks at me and smiles. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Something about that smile feels fake\u2026 it almost feels like
      she\u2019s upset that I did well. But maybe I\u2019m just overthinking it. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "That challenge was intense. What made the situation worse was
      the trainer yelling at everyone\u2026 he\u2019s not as chill as I thought he\u2019d
      be. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I feel really bad for Xuan Mo though\u2026 he wouldn\u2019t get
      off her back. Maybe I should check on her. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "Hey Xuan Mo, are you okay? You\u2019re sweating a lot. "
    centerCharacter: {fileID: 1350420248254977967, guid: 9c90e2963e488bb42990a62282eb1c4a, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Xuan Mo looks at me and sighs. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Xuan Mo
    dialogueText: I'm fine.
    centerCharacter: {fileID: 230790951476849518, guid: 9c90e2963e488bb42990a62282eb1c4a, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "Okay\u2026 I was just worried. You seem a bit out of it right
      now."
    centerCharacter: {fileID: 8382687041527233505, guid: e74945277a1c7ba4695a0c7f981eccd1, type: 3}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Xuan Mo
    dialogueText: 'You should worry about yourself here.

'
    centerCharacter: {fileID: 8382687041527233505, guid: e74945277a1c7ba4695a0c7f981eccd1, type: 3}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Well damn\u2026 I guess this is why nobody talks to her. She makes
      it really difficult\u2026 but I\u2019ll still try.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Cheomni
    dialogueText: "Leave her. She\u2019s always like this. Don\u2019t waste your
      precious breath.\r\n"
    centerCharacter: {fileID: -713786873062891167, guid: 6bc7591e2cec90747ab909b04b5a1b87, type: 3}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: The room goes quiet.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Cheomni
    dialogueText: 'Today your performance was quite good for a newbie.

'
    centerCharacter: {fileID: -2283282695645151907, guid: 6bc7591e2cec90747ab909b04b5a1b87, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: She smiles but that didn't feel like a compliment...
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "Haahh\u2026Thank you.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -7555613608946788345, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Manager
    dialogueText: 'So much chatter today. I see Yeonhee is quite the talker.

'
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Again\u2026 Why is it always me?\n\r\nBut at least he broke the
      silence\u2026\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -4193493033591885765, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: Sorry...
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Let\u2019s discuss today\u2019s session. It seems we\u2019ve been
      too soft on some of you\u2026 to the point where a newbie surpasses you on
      her first try. Ridiculous.\r\n"
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: The room goes tense
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 8300000, guid: 4b4d12a56e1af1f4e96414333857598c, type: 3}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Yeonhee, your voice\u2026 work on it. It sounds childish. I asked
      for cute, not toddler.\r\n"
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: Wow...okay.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -8388179541503621137, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: 'Xuan Mo, forgetting lyrics again. Have you even been attending
      your language classes? Your Korean sounds choppy.

'
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Xuan Mo keeps the same expressionless look she does all the time.

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: 'Rose, your voice is too powerful. If you want to be a solo artist,
      then leave. Stop trying to outshine everyone. At least your Korean is understandable.

'
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: Rose looks down quietly.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: 'Yoenseo, you were good. Just fix the voice cracks.

'
    centerCharacter: {fileID: 6720074716192057993, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonseo
    dialogueText: 'Thank you, sir!

'
    centerCharacter: {fileID: 7522834289488228649, guid: a5c7235e2931de04183b3b9377c374da, type: 3}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'The trainer pauses, then looks at Cheomni.

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I feel nervous for her\u2026 she made the most mistakes.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: 'Cheomni, perfect as always. Just work on remembering your lyrics
      without stuttering.

'
    centerCharacter: {fileID: 5958077972718859125, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "What? That\u2019s not fair\u2026 she messed up the most.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -8388179541503621137, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Evaluations are over. Fix what I told you. I don\u2019t want to
      hear these mistakes again.\r\n"
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "He leaves.\rThe room finally feels lighter.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -7847799068464056061, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Manager
    dialogueText: 'Good job, girls. We just need more practice. See you tomorrow.

'
    centerCharacter: {fileID: -4916068718670936503, guid: 4ae79176973886e48ad0767919bd05d9, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "He looks calm\u2026 but I can literally see a vein popping on
      his forehead.\r\nWhat's wrong with him?\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: We all start heading back to the dorm.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
