MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8e05ad892727404cbf0e9f236e5d962, type: 3}
  m_Name: A_Bad
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    dialogueText: "My heart is pounding\u2026 that was so difficult. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 8300000, guid: 4b4d12a56e1af1f4e96414333857598c, type: 3}
    bgm: {fileID: 8300000, guid: 4738bdf42274e5c428f3975904410d66, type: 3}
    flicker: 0
    flickerDuration: 0
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I can\u2019t believe I did so terribly, I really thought I would
      get the hang of it immediately. Everyone sounded so good, even with their mistakes\u2026
      and then you get me.  "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'I really need to work on my vocals. Rose sounded amazing, it was
      like hearing an angel sing. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'All the girls sit together on the couch while the manager and
      trainer talk on the other side of the room. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I wonder what they\u2019re saying about me\u2026 the trainer keeps
      looking my way. I hope they don\u2019t kick me out, I wouldn\u2019t blame them
      if they did. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'But to my surprise, Cheomni is sitting alone on the other side
      of the room. She glances at me, then looks back at the wall. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Something about that glance\u2026 It makes me feel uncomfortable.
      But maybe I\u2019m just overthinking it. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "That challenge was intense. What made the situation worse was
      the trainer yelling at everyone\u2026 he\u2019s not as chill as I thought he\u2019d
      be. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I feel really bad for Xuan Mo though\u2026 he wouldn\u2019t get
      off her back. Maybe I should check on her. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "Hey Xuan Mo, are you okay? You\u2019re sweating a lot."
    centerCharacter: {fileID: 230790951476849518, guid: 9c90e2963e488bb42990a62282eb1c4a, type: 3}
    leftCharacter: {fileID: -7847799068464056061, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Xuan Mo looks at me and sighs. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Xuan Mo
    dialogueText: "I\u2019m fine."
    centerCharacter: {fileID: 8382687041527233505, guid: e74945277a1c7ba4695a0c7f981eccd1, type: 3}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: Yeonhee
    dialogueText: "Okay\u2026 I was just worried. You seem a bit out of it.\r\n"
    centerCharacter: {fileID: 8382687041527233505, guid: e74945277a1c7ba4695a0c7f981eccd1, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Xuan Mo
    dialogueText: You should worry about yourself here.
    centerCharacter: {fileID: 8382687041527233505, guid: e74945277a1c7ba4695a0c7f981eccd1, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: 
    dialogueText: "Well damn\u2026 I guess this is why nobody talks to her. She makes
      it really difficult\u2026 but I\u2019ll still try.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: Cheomni
    dialogueText: "Leave her. She\u2019s always like this. "
    centerCharacter: {fileID: 5966397245952142445, guid: 6bc7591e2cec90747ab909b04b5a1b87, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: 
    dialogueText: The room goes quiet.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: 
    dialogueText: "Cheomni stares at me before speaking, like she\u2019s choosing
      her words.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: Cheomni
    dialogueText: "Your performance was questionable, but I guess it wasn\u2019t
      that bad\u2026"
    centerCharacter: {fileID: -2765307166731166788, guid: 733aa15cbc0f5eb418d5c9e0723b02c9, type: 3}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: 
    dialogueText: "That didn\u2019t feel like a compliment\u2026"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -2528963852601738924, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: Yeonhee
    dialogueText: "Haahh\u2026 thanks."
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -7555613608946788345, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: Manager
    dialogueText: 'So much chatter coming from you, Yeonhee. You should get rid of
      that habit.

'
    centerCharacter: {fileID: 8822399858603782341, guid: 4ae79176973886e48ad0767919bd05d9, type: 3}
    leftCharacter: {fileID: 7041811409493127568, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Again\u2026 Why is it always me?\r\nAt least he broke the silence\u2026"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -4193493033591885765, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "Sorry\u2026"
    centerCharacter: {fileID: 6654811726689088912, guid: 4ae79176973886e48ad0767919bd05d9, type: 3}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Let\u2019s discuss today\u2019s session. It seems we\u2019ve been
      too soft on some of you\u2026 I don\u2019t know what happened, but today\u2019s
      performance was absolutely ridiculous.\r\n"
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'The room goes tense

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 8300000, guid: 4b4d12a56e1af1f4e96414333857598c, type: 3}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Yeonhee, your voice\u2026 work on it. It sounds childish. I asked
      for cute, not toddler. And what\u2019s up with you forgetting a simple lyric?
      If you want to continue in this company, pull up your socks. I don\u2019t want
      to talk about this ridiculous performance next time. I\u2019ll create a separate
      schedule for you to practice outside of training hours. You need it.\r\n"
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 5379208666965357097, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Cheomni laughs softly.

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 8300000, guid: 8a012450950979040a148b8b5d4a20d7, type: 3}
    bgm: {fileID: 8300000, guid: 17304ea353f81ae41b4b80230605d607, type: 3}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "What\u2019s her deal anyway?\r\nThis is actually so embarrassing\u2026
      he didn\u2019t have to be that harsh.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: -8388179541503621137, guid: 2e78d886561996c4eb61c91fdd03780e, type: 3}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: 'Xuan Mo, forgetting lyrics again. Have you even been attending
      your language classes? Your Korean sounds choppy.

'
    centerCharacter: {fileID: -3963459755102996256, guid: 7ccc637e2ae6a6549b7fe74e9687f88d, type: 3}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
    flickerDuration: 1
    shaderName: 
    shake: 0
    shakeDuration: 0.5
    shakeStrength: 5
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Xuan Mo keeps the same expressionless look she always has.

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    bgm: {fileID: 0}
    flicker: 0
