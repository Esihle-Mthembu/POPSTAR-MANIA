    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonseo
    dialogueText: "Let\u2019s just throw this out and go to sleep.\r\n"
    centerCharacter: {fileID: 0}
