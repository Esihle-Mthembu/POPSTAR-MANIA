%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8e05ad892727404cbf0e9f236e5d962, type: 3}
  m_Name: A_Good
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    dialogueText: "My heart is pounding\u2026 that was so difficult. I really need
      to work on my vocals. Rose sounded amazing, even though she messed up. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 8300000, guid: 4b4d12a56e1af1f4e96414333857598c, type: 3}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'All the girls sit together on the couch while the manager and
      trainer talk on the other side of the room. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I wonder what they\u2019re saying about me\u2026 the trainer keeps
      looking my way. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'To my surprise, Cheonmi is sitting alone on the other side of
      the room. She glances at me, then looks back at the wall. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Something about that glance\u2026 it almost feels like she\u2019s
      upset that I did well. But maybe I\u2019m just overthinking it. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "That challenge was intense. What made the situation worse was
      the trainer yelling at everyone\u2026 he\u2019s not as chill as I thought he\u2019d
      be. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "I feel really bad for Xuan Mo though\u2026 he wouldn\u2019t get
      off her back. Maybe I should check on her. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: Hey Xuan Mo, are you okay? You're sweating a lot.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: -4892683488605231937, guid: 5482bc231f43b5947b5996fae1d5f884, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Xuan Mo looks at me and sighs. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Xuan Mo
    dialogueText: I'm fine.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: " Okay\u2026 I was just worried. You seem a bit out of it right
      now."
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 1
    isEndOfBranch: 1
  - speakerName: Xuan Mo
    dialogueText: You should worry about yourself here.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Well damn\u2026 I guess this is why nobody talks to her. She makes
      it really difficult\u2026 but I\u2019ll still try. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Cheonmi
    dialogueText: "Leave her. She\u2019s always like this. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: The room goes quiet.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Cheomni stares at me for a moment, like she\u2019s thinking about
      what to say."
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Cheonmi
    dialogueText: "Your performance was questionable, but I guess it wasn\u2019t
      that bad\u2026 just don\u2019t start running to the top position now. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "That didn\u2019t feel like a compliment\u2026"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: Haahh...thanks.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Manager
    dialogueText: So much chatter today. I see Yeonhee is quite the talker.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Again\u2026 Why is it always me? "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "At least he broke the silence\u2026 \r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: Sorry...
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Let\u2019s discuss today\u2019s session. It seems we\u2019ve been
      too soft on some of you\u2026 to the point where a newbie surpasses you on
      her first try. Ridiculous. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: The room goes tense.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 8300000, guid: 4b4d12a56e1af1f4e96414333857598c, type: 3}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Yeonhee, your voice\u2026 work on it. It sounds childish. I asked
      for cute, not toddler."
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Wow\u2026 okay. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Xuan Mo, forgetting lyrics again. Have you even been attending
      your language classes? Your Korean sounds choppy. \r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: Xuan Mo keeps that same expressionless look she always has.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: 'Rose, your voice is too powerful. If you want to be a solo artist,
      then leave. Stop trying to outshine everyone. At least your Korean is understandable. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Rose looks down quietly. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: Yoenseo, you were good. Just fix the voice cracks.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonseo
    dialogueText: Thank you, sir!
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'The trainer pauses, then looks at Cheonmi. '
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "As bad as it sounds\u2026 I actually can\u2019t wait for her to
      get scolded. She\u2019s been on her high horse since I got here\u2026 and she
      made the most mistakes out of everyone. "
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: Cheomni, perfect as always. Just work on remembering your lyrics
      without stuttering.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "What? That\u2019s not fair\u2026 she messed up the most.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Trainer
    dialogueText: "Evaluations are over. Fix what I told you. I don\u2019t want to
      hear these mistakes again.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'He leaves.

      The room finally feels lighter'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Manager
    dialogueText: 'Good job, girls. We just need more practice. See you tomorrow.

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "He looks calm\u2026 but I can literally see a vein popping on
      his forehead.\r\nWhat\u2019s wrong with him?\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 1087448506538228221, guid: 6d7c11184b3aa164d9a0fe4825d49c02, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'We all start heading back to the dorm.

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Rose wraps her arm around mine while Yoenseo walks beside me.
      It feels like we\u2019re getting closer\u2026 It makes today feel a little
      less exhausting.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Rose
    dialogueText: "Well\u2026 I guess we\u2019re sleeping early today.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: Why?
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonseo
    dialogueText: You'll see.
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "hmmm....\nI can\u2019t stop thinking about Rose\u2019s voice\u2026
      I barely even hear the conversation.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonhee
    dialogueText: "Uh\u2026 Rose\u2026 I think you have a really beautiful voice.
      I want to sing like you someday.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Rose smiles softly, but before she can reply

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Cheomni
    dialogueText: "Your opinion doesn\u2019t really matter here. If you want to succeed,
      listen to the trainers\u2026 not Rose."
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: Yeonseo
    dialogueText: "I guess that didn\u2019t work out for you today though.\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "Cheomni\u2019s expression tightens, but she says nothing and walks
      ahead.\r\nThere\u2019s so much tension here\u2026\r\n"
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
    background: {fileID: 5875038362160349911, guid: 0b109640604cff64aa5599cde9d03fa7, type: 3}
    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: 'Back at the dorm, everyone gathers to check their scoreboards.

'
    centerCharacter: {fileID: 0}
    leftCharacter: {fileID: 0}
