    backgroundMusic: {fileID: 0}
    choices: []
    triggersLyricsGame: 0
    isEnding: 0
    isEndOfBranch: 0
  - speakerName: 
    dialogueText: "We clean everything up together. It makes me uneasy\u2026 Why
